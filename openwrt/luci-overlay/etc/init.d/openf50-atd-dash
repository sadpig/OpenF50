#!/bin/sh /etc/rc.common
# The control panel's own AT channels (K19): openf50-atd on nr6 and nr7, kept open for the life of the boot.
# openwrt-luci only. nr1 (general) and nr2 (mobile-data) belong to openf50-atd; while mobile-data dials, AT+CGDATA
# blocks nr2 for 10-20 s and the dashboard's refresh must not queue on nr1 behind the panel's other commands
# ("openf50-at: busy"). The panel's collector (unisoc-modem/cell) claims one of /run/openf50-at6 and /run/openf50-at7
# without waiting and falls back to /run/openf50-at (nr1) when neither command fifo exists. nr3-nr5 are slot 1's.
# No URC channel here: nr1's daemon reads the URCs.
#
# START=19 like openf50-atd: a collector that runs before its daemon exists would open the tty itself.
START=19
USE_PROCD=1
export PATH="$PATH:/opt/openf50/busybox-bin"

# Same wait as openf50-atd's (bounded 240 s, inside the procd command, procd respawns and retries).
wait_and_exec() {
	# $1 = tty node, $2.. = the daemon (its environment is set by procd_set_param env)
	local dev=$1; shift
	echo "n=0; while [ ! -c $dev ]; do n=\$((n+1)); if [ \"\$n\" -gt 240 ]; then echo 'openf50-atd-dash: $dev never appeared' >&2; exit 1; fi; sleep 1; done; exec $*"
}

start_service() {
	# Hot switching keeps exactly the four main/data owners; optional SIM1 pool must not reopen while inactive.
	[ ! -e /run/openf50/sim-managed ] || return 0
	# SIM2's collector uses the already-owned nr4 channel; nr6/nr7 belong to the SIM1 pool.
	local slot=0
	[ ! -x /opt/openf50/bin/openf50-sim ] || slot=$(/opt/openf50/bin/openf50-sim active) || return 1
	[ "$slot" = 0 ] || return 0
	local n
	for n in 6 7; do
		procd_open_instance atd$n
		procd_set_param command /bin/sh -c "$(wait_and_exec /dev/stty_nr$n /opt/openf50/bin/openf50-atd)"
		procd_set_param env OPENF50_AT_DEV=/dev/stty_nr$n OPENF50_AT_DIR=/run/openf50-at$n OPENF50_AT_URC_CHANNELS=
		procd_set_param respawn 3600 10 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done
}
