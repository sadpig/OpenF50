#!/bin/sh
# Keep the SMS pool of the control panel (openf50-sms, /etc/openf50/sms-pool) in step with the SIM. openwrt-luci only.
#
# A new message is noticed by its +CMTI: openf50-atd appends every unsolicited line of the modem to
# $ATDIR/urc/*.log, so a new "+CMTI:" changes the checksum of the +CMTI lines there, and that starts a sync. The
# logs are emptied when they grow too large, which changes the checksum too: a sync is idempotent, so a spurious
# one costs one AT+CMGL. A full sync also runs every OPENF50_SMS_SYNC_INTERVAL seconds, for an announcement that
# was missed.
#
# Nothing here deletes from the SIM; that is "openf50-sms delete ID --sim", asked for by someone.
#
# Port of the fork's openf50-smsd (kanoqwq/clean-tf-7.2, cd4fb28), with the pool in /etc/openf50/sms-pool (D11).
set -u
export PATH="$PATH:/opt/openf50/bin:/opt/openf50/busybox-bin:/usr/sbin:/sbin"

POOL=${OPENF50_SMS_POOL:-/etc/openf50/sms-pool}
export OPENF50_SMS_POOL=$POOL
ATDIR=${OPENF50_AT_DIR:-/run/openf50-at}
URCDIR=$ATDIR/urc
POLL=${OPENF50_SMS_POLL:-5}
SYNC_INTERVAL=${OPENF50_SMS_SYNC_INTERVAL:-30}
SMS=${OPENF50_SMS_BIN:-/opt/openf50/bin/openf50-sms}

# One daemon: a second one (a service started twice) leaves the pool to a live first one, and takes the lock over
# from one that died without letting go of it.
LOCK=${OPENF50_SMS_LOCK:-/run/openf50-smsd.lock}
alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null || return 1
    [ -d /proc/self ] || return 0
    { tr '\0' ' ' < "/proc/$1/cmdline"; } 2>/dev/null | grep -q openf50-smsd
}
while ! mkdir "$LOCK" 2>/dev/null; do
    owner=$(cat "$LOCK/pid" 2>/dev/null || true)
    if alive "$owner"; then
        echo "openf50-smsd: pid $owner is already pooling into $POOL" >&2
        exit 0
    fi
    rm -rf "$LOCK"
done
echo $$ > "$LOCK/pid"
release() { [ "$(cat "$LOCK/pid" 2>/dev/null)" = $$ ] && rm -rf "$LOCK"; }
trap release EXIT
trap 'exit 0' INT TERM

# openf50-atd owns the AT channel; until its command fifo is there nothing can be asked
n=0
until [ -p "$ATDIR/cmd" ]; do
    n=$((n + 1))
    [ "$n" -gt 120 ] && { echo "openf50-smsd: no command fifo from openf50-atd after ten minutes, exiting" >&2; exit 1; }
    sleep 5
done

# the SIM needs its time after a boot; a modem that never says READY still gets the periodic syncs below
n=0
until openf50-at -t 4 'AT+CPIN?' 2>/dev/null | grep -q READY; do
    n=$((n + 1))
    [ "$n" -gt 60 ] && { echo "openf50-smsd: the SIM never became ready, syncing anyway" >&2; break; }
    sleep 10
done
# Without CNMI the modem stores a new message silently and no +CMTI ever comes: ask for the storage indications.
# A refusal still leaves the periodic sync.
openf50-at -t 4 'AT+CNMI=2,1,0,0,0' >/dev/null 2>&1 || true
"$SMS" sync || echo "openf50-smsd: the first sync failed, retrying later" >&2

# md5sum first: OpenWrt's busybox has no cksum
signature() {
    cat "$URCDIR"/*nr*.log 2>/dev/null | grep -aF '+CMTI' | { md5sum 2>/dev/null || cksum; }
}

last=$(signature)
elapsed=0
echo "openf50-smsd: pooling into $POOL (a look every ${POLL} s, a full sync every ${SYNC_INTERVAL} s)" >&2
while :; do
    sleep "$POLL"
    s=$(signature)
    if [ "$s" != "$last" ]; then
        last=$s
        sleep 2   # let the message land in the storage before listing it
        "$SMS" sync || echo "openf50-smsd: sync failed, retrying on the next trigger" >&2
        elapsed=0
        continue
    fi
    elapsed=$((elapsed + POLL))
    if [ "$elapsed" -ge "$SYNC_INTERVAL" ]; then
        elapsed=0
        "$SMS" sync >/dev/null || true
    fi
done
