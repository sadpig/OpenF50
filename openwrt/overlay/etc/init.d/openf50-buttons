#!/bin/sh /etc/rc.common
# the buttons: power wakes the LEDs (held: shut down), the U30 Air's Wi-Fi key switches the hotspot band
# (see /opt/openf50/bin/openf50-buttons)
START=95
USE_PROCD=1
export PATH="$PATH:/opt/openf50/busybox-bin"

start_service() {
	[ -x /opt/openf50/bin/openf50-keys ] || return 0
	procd_open_instance buttons
	procd_set_param command /opt/openf50/bin/openf50-buttons
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
