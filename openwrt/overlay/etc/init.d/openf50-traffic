#!/bin/sh /etc/rc.common
# The mobile data count (openf50-traffic run): the interface's counters once a minute into RAM, the disk copy every
# 30 minutes and at shutdown (stop: SIGTERM, the service saves before it exits). STOP=10 runs before umount.
START=96
STOP=10
USE_PROCD=1
export PATH="$PATH:/opt/openf50/busybox-bin"

start_service() {
	procd_open_instance
	procd_set_param command /opt/openf50/bin/openf50-traffic run
	procd_set_param env PATH="$PATH"
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 10
	procd_set_param stderr 1
	procd_close_instance
}
