#!/bin/sh /etc/rc.common
# power profiles: the hotspot, the modem and the LEDs go off when nobody is connected, the charging boot, the
# charge guard (see /opt/openf50/bin/openf50-power)
START=97
USE_PROCD=1
export PATH="$PATH:/opt/openf50/busybox-bin"

start_service() {
	[ -x /opt/openf50/bin/openf50-power ] || return 0
	procd_open_instance power
	procd_set_param command /opt/openf50/bin/openf50-power daemon
	# mobile-data suspend/resume through netifd (ifdown/ifup wan), as the watcher in openf50-post does
	procd_set_param env OPENF50_NETIFD=1
	procd_set_param respawn 3600 10 0
	# stopped while idle, the TERM trap brings the radios back without a dial (the radio lock takes up to ~120 s)
	procd_set_param term_timeout 150
	procd_close_instance
}
