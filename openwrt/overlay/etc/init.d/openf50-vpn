#!/bin/sh /etc/rc.common
# VLESS via Xray (default) or sing-box, on a TUN; settings in /etc/openf50/vpn.conf, see /opt/openf50/bin/openf50-vpn
START=95
USE_PROCD=1
export PATH="$PATH:/opt/openf50/busybox-bin"

start_service() {
	[ -r /etc/openf50/vpn.conf ] || return 0
	procd_open_instance vpn
	procd_set_param command /opt/openf50/bin/openf50-vpn run
	procd_set_param env PATH="$PATH"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
