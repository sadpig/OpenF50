# OPENF50: record dmesg and procd/service state into the Linux boot partition's persistent log area for the first minutes,
# so tools/collect-logs.sh can show from Android why a boot did not complete.
openf50_early_recorder() {
	[ -x /opt/openf50/bin/early-recorder ] || return 0
	PATH="$PATH:/opt/openf50/busybox-bin" /opt/openf50/bin/early-recorder 420 </dev/null >/dev/null 2>&1 &
}

boot_hook_add preinit_essential openf50_early_recorder
