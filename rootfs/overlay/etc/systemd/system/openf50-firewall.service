[Unit]
Description=OPENF50 host firewall (block connections from the cellular network)
DefaultDependencies=no
Before=network-pre.target openf50-mobile-data.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/openf50/firewall.nft

[Install]
WantedBy=sysinit.target
