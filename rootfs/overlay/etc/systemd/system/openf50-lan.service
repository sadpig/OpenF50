[Unit]
Description=OPENF50 LAN bridge br-lan (USB + Wi-Fi, 192.168.77.1/24 on an F50 and 192.168.78.1/24 on a U30 Air by default, see /etc/openf50/lan.conf, DHCP/DNS)
After=network-pre.target
Wants=network-pre.target

[Service]
ExecStart=/opt/openf50/bin/lan-start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
