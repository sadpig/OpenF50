[Unit]
Description=OPENF50 Wi-Fi scan mode for this boot (the hotspot off so the radio can list networks; 10 minutes at most)
ConditionPathExists=/etc/openf50/wifi-scan-mode
# wifi-client needs wlan0, which openf50-wifi brings
After=openf50-wifi.service
Wants=openf50-wifi.service
Before=openf50-hotspot.service

[Service]
Type=oneshot
ExecStart=/opt/openf50/bin/wifi-client scan-mode boot

[Install]
WantedBy=multi-user.target
