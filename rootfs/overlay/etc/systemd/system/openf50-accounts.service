[Unit]
Description=OPENF50 carry the accounts over from the system an older openf50-update replaced
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-tmpfiles-setup.service systemd-sysusers.service dbus.service ssh.socket ssh.service systemd-user-sessions.service
ConditionPathExists=/etc/.openf50-accounts-from-image

[Service]
Type=oneshot
ExecStart=/opt/openf50/bin/openf50-update accounts

[Install]
WantedBy=sysinit.target
