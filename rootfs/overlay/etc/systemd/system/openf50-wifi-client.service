[Unit]
Description=OPENF50 join the saved Wi-Fi network (station mode; stops the hotspot while connected)
ConditionPathExists=/etc/openf50/wifi-client.conf
After=openf50-wifi.service openf50-lan.service
Wants=openf50-wifi.service
Before=openf50-hotspot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/openf50/bin/wifi-client up
# A stop or restart would otherwise kill the supplicant and its helpers (the service's cgroup) and leave the rules,
# the address and the route behind. "release" takes the client down and nothing else: not "disconnect", which
# would also clear the scan-mode flag that the coming boot is meant to use, and start the hotspot.
ExecStop=/opt/openf50/bin/wifi-client release

[Install]
WantedBy=multi-user.target
