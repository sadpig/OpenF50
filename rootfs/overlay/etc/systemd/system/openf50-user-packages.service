[Unit]
Description=OPENF50 install the packages of the system before the update again (openf50-user-packages)
ConditionFileNotEmpty=/etc/openf50/user-packages/wanted
After=network.target openf50-mobile-data.service

[Service]
# it waits for the internet itself (an hour at most, then again at the next boot): the boot does not wait for it
Type=simple
ExecStart=/opt/openf50/bin/openf50-user-packages run
