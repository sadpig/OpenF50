[Unit]
Description=OPENF50 modem AT channel keeper, second channel (nr2) for mobile data (see /opt/openf50/bin/openf50-atd)
# the SIPC tty only exists once the vendor modem stack is up
ConditionPathExists=|/dev/stty_nr2
ConditionPathExists=|/dev/stty_nr5
After=openf50-vendor.service
Wants=openf50-vendor.service
StartLimitIntervalSec=0

[Service]
Environment=OPENF50_AT_ROLE=data
Environment=OPENF50_AT_DIR=/run/openf50-at2
# empty: no URC channel here, the nr1 daemon reads the URCs
Environment=OPENF50_AT_URC_CHANNELS=
ExecStart=/opt/openf50/bin/openf50-atd
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
