[Unit]
Description=OPENF50 power profiles: idle radios when nobody is connected, the charging boot, the charge guard
After=openf50-hotspot.service openf50-mobile-data.service openf50-buttons.service
ConditionPathExists=/opt/openf50/bin/openf50-power

[Service]
ExecStart=/opt/openf50/bin/openf50-power daemon
Restart=always
RestartSec=10
# stopped while idle, the TERM trap brings back the hotspot, LEDs and CPU, then the radio without a dial (up to ~120 s
# for the radio lock; the watchdog redials); not during a shutdown
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
